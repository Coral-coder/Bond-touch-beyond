DEFINE SCHEMA

    -- The whole iCloud relay is one record type with one encrypted field. Records are read
    -- by name only (no queries), so no QUERYABLE/SORTABLE indexes are needed.
    -- Builds use the Development environment, which creates this type on first use; this
    -- file is only for deploying to Production later.
    RECORD TYPE BTItem (
        payload     BYTES,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );
