DEFINE SCHEMA

    -- Bond Touch Beyond iCloud relay (public database).
    --
    -- Each kind of data has its own record type. Everything is in the encrypted `payload`
    -- field (AES-GCM, key derived on the phones from the invite code, which never goes to
    -- iCloud). Record names are opaque IDs derived from the code, and records are read by
    -- name only — so no QUERYABLE / SORTABLE indexes are needed.
    --
    -- The other fields are from the earlier schema already deployed to Production; they're
    -- kept so this import only ADDS (Production doesn't allow removing fields). They're unused.
    --
    -- Import in the CloudKit Console (Development schema), then Deploy Schema Changes to
    -- Production.

    RECORD TYPE Bond (
        ownerName   STRING,
        payload     BYTES,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_icloud"
    );

    RECORD TYPE Profile (
        senderID    STRING,
        name        STRING,
        colorRGB    INT64,
        photo       ASSET,
        sentAt      TIMESTAMP,
        payload     BYTES,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_icloud"
    );

    RECORD TYPE Photo (
        payload     BYTES,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_icloud"
    );

    RECORD TYPE Presence (
        senderID    STRING,
        online      INT64,
        lat         DOUBLE,
        lng         DOUBLE,
        sentAt      TIMESTAMP,
        payload     BYTES,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_icloud"
    );

    RECORD TYPE Heartbeat (
        senderID    STRING,
        bpm         INT64,
        sentAt      TIMESTAMP,
        payload     BYTES,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_icloud"
    );

    RECORD TYPE Touch (
        senderID    STRING,
        pattern     BYTES,
        generation  INT64,
        colorRGB    INT64,
        endColorRGB INT64,
        sentAt      TIMESTAMP,
        payload     BYTES,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_icloud"
    );

    RECORD TYPE Message (
        senderID    STRING,
        kind        STRING,
        text        STRING,
        colorRGB    INT64,
        sentAt      TIMESTAMP,
        image       ASSET,
        payload     BYTES,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_icloud"
    );

    RECORD TYPE Cursor (
        payload     BYTES,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_icloud"
    );
