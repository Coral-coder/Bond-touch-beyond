DEFINE SCHEMA

    RECORD TYPE Bond (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        ownerName       STRING,
        payload         BYTES,
        GRANT READ, WRITE TO "_creator",
        GRANT READ, CREATE TO "_icloud"
    );

    RECORD TYPE Cursor (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        payload         BYTES,
        GRANT READ, WRITE TO "_creator",
        GRANT READ, CREATE TO "_icloud"
    );

    RECORD TYPE Heartbeat (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        bpm             INT64,
        payload         BYTES,
        senderID        STRING,
        sentAt          TIMESTAMP,
        GRANT READ, WRITE TO "_creator",
        GRANT READ, CREATE TO "_icloud"
    );

    RECORD TYPE Message (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        colorRGB        INT64,
        image           ASSET,
        kind            STRING,
        payload         BYTES,
        senderID        STRING,
        sentAt          TIMESTAMP,
        text            STRING,
        GRANT READ, WRITE TO "_creator",
        GRANT READ, CREATE TO "_icloud"
    );

    RECORD TYPE Photo (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        payload         BYTES,
        GRANT READ, WRITE TO "_creator",
        GRANT READ, CREATE TO "_icloud"
    );

    RECORD TYPE Presence (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        lat             DOUBLE,
        lng             DOUBLE,
        online          INT64,
        payload         BYTES,
        senderID        STRING,
        sentAt          TIMESTAMP,
        GRANT READ, WRITE TO "_creator",
        GRANT READ, CREATE TO "_icloud"
    );

    RECORD TYPE Profile (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        colorRGB        INT64,
        name            STRING,
        payload         BYTES,
        photo           ASSET,
        senderID        STRING,
        sentAt          TIMESTAMP,
        GRANT READ, WRITE TO "_creator",
        GRANT READ, CREATE TO "_icloud"
    );

    RECORD TYPE Touch (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        colorRGB        INT64,
        endColorRGB     INT64,
        generation      INT64,
        pattern         BYTES,
        payload         BYTES,
        senderID        STRING,
        sentAt          TIMESTAMP,
        GRANT READ, WRITE TO "_creator",
        GRANT READ, CREATE TO "_icloud"
    );

    RECORD TYPE Users (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        roles           LIST<INT64>,
        GRANT READ, WRITE TO "_creator",
        GRANT READ TO "_world"
    );

    RECORD TYPE "cloudkit.share" (
        "___createTime"               TIMESTAMP,
        "___createdBy"                REFERENCE,
        "___etag"                     STRING,
        "___modTime"                  TIMESTAMP,
        "___modifiedBy"               REFERENCE,
        "___recordID"                 REFERENCE,
        "cloudkit.thumbnailImageData" BYTES,
        "cloudkit.title"              STRING,
        "cloudkit.type"               STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );
