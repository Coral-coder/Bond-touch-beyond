DEFINE SCHEMA

    -- The whole iCloud relay is one record type with one encrypted field. Records are read
    -- by name only (no queries), so no QUERYABLE/SORTABLE indexes are needed.
    -- Import into the Development schema in the CloudKit Console, then Deploy Schema Changes
    -- to Production (builds use Production).
    RECORD TYPE BTItem (
        payload     BYTES,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );
